{
  "manifest_version": 3,
  "name": "Arena Agent Mode Pro",
  "short_name": "AAMP",
  "description": "A transparent, safety-first assistant for Arena.ai Agent Mode.",
  "version": "8.0.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "notifications",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Arena Agent Mode Pro"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "js": [
        "content/arena-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
